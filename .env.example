# Copy to .env.local for development. Fill blank values privately.
# Neon: use both connection strings from the same development branch.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
# Generate a unique random cookie secret of at least 32 characters.
NEON_AUTH_COOKIE_SECRET=
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=

# Stream: public app key and matching server-only secret.
NEXT_PUBLIC_STREAM_API_KEY=
STREAM_API_SECRET=

# ImageKit: delivery endpoint and matching account keys.
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=

# Stripe Sandbox: use test credentials and the local listener's signing secret.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_APP_URL=http://localhost:3000
# Supply the platform's percentage, from 0 to 100.
STRIPE_PLATFORM_FEE_PERCENT=
# JSON object mapping trainer profile user IDs to connected account IDs.
STRIPE_TRAINER_ACCOUNTS={}

# Sentry: leave the DSN empty to disable reporting locally.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Optional build-time credential for source map uploads.
SENTRY_AUTH_TOKEN=
