node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/
playwright-report/
test-results/

# next.js
.next/
out/
/output/

# production
build/
dist/
.turbo/
.cache/

# misc
.DS_Store
Thumbs.db
Desktop.ini
*.tmp
*.temp
*.swp
*.swo
*.local.backup
*.pem

# debug
*.log
pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
