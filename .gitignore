# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.sample

# vercel
.vercel/

# typescript
*.tsbuildinfo
next-env.d.ts
.neon
.stream/

# Markdown, except the project README
*.md
!/README.md
